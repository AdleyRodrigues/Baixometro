# =============================================================================
# Baixômetro — Variáveis de Ambiente (.env.example)
# Copie este arquivo para `.env` (`cp .env.example .env`) e ajuste os valores.
# =============================================================================

# --- Banco de Dados (PostgreSQL Local ou Gerenciado: Neon, Supabase, Render, Railway) ---
POSTGRES_USER=baixometro
POSTGRES_PASSWORD=baixometro_dev
POSTGRES_DB=baixometro
# Em produção com banco gerenciado, use a string completa (ex.: postgres://user:pass@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgres://baixometro:baixometro_dev@postgres:5432/baixometro

# --- Backend (Rust / Axum) ---
PORT=3000
API_PORT=3000
RUST_LOG=info,baixometro_api=debug
# OBRIGATÓRIO EM PRODUÇÃO: Gere um segredo forte executando: `openssl rand -base64 32`
JWT_SECRET=baixometro_dev_jwt_secret_change_in_prod

# --- Frontend (React / Vite) ---
# Use `/api` quando servido pelo Nginx com proxy reverso (Docker Compose)
# ou a URL pública completa da API em PaaS separado (ex.: https://baixometro-api.onrender.com)
VITE_API_URL=/api

# Chave Pix para receber doações voluntárias na página de suporte (opcional).
# Se deixado em branco, a opção de Pix é ocultada e exibe apenas GitHub Sponsors/Ko-fi.
VITE_PIX_KEY=
