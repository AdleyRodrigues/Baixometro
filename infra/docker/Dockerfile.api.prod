# Stage 1: Builder (Debian Bookworm com toolchain Rust estável compatível com Cargo.lock v4)
FROM rust:1-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY apps/api/Cargo.toml apps/api/Cargo.toml
COPY infra/migrations infra/migrations
COPY apps/api/src apps/api/src

RUN cargo build --release --locked --bin baixometro_api

# Stage 2: Runtime enxuto (Debian Bookworm Slim)
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/baixometro_api /usr/local/bin/baixometro_api

ENV API_PORT=3000
ENV RUST_LOG=info,baixometro_api=info

EXPOSE 3000

CMD ["baixometro_api"]

