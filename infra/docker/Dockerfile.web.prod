# Stage 1: Build da SPA React/Vite
FROM node:22-alpine AS builder

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared-types packages/shared-types
COPY apps/web apps/web

# Permite injetar a URL pública da API no momento do build (ex.: --build-arg VITE_API_URL=https://api.seudominio.com)
# Por padrão usa `/api` (proxy reverso configurado no nginx.conf)
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

ARG VITE_PIX_KEY=""
ENV VITE_PIX_KEY=${VITE_PIX_KEY}

RUN pnpm install --frozen-lockfile
RUN pnpm build:web

# Stage 2: Servidor Nginx de produção com suporte a SPA (React Router) e proxy reverso para /api
FROM nginx:alpine AS runtime

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
